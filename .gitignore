# 1. 第三方依赖（体积庞大且可通过 npm install 自动重新安装）
node_modules/
.pnp
.pnp.js

# 2. 构建产物与临时编译输出（可通过 npm run build 随时生成）
dist/
dist-ssr/
*.local
*.tsbuildinfo
.vite/

# 3. 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. 环境变量与私有配置
.env.local
.env.*.local

# 5. 编辑器与 IDE 配置目录（避免团队成员配置冲突）
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. 操作系统生成的临时文件
.DS_Store
Thumbs.db
